{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-personal-vault.org/schema/v1/strategy.json",
  "title": "Strategy Data v1",
  "type": "object",
  "required": [
    "strategy_id",
    "name",
    "description",
    "rule",
    "applicable_context",
    "prerequisites",
    "expected_outcome",
    "evidence",
    "success_count",
    "failure_count",
    "inconclusive_count",
    "confidence",
    "status",
    "version",
    "provenance",
    "source_experiences",
    "supersedes",
    "superseded_by",
    "created_at",
    "updated_at",
    "metadata"
  ],
  "properties": {
    "strategy_id": { "type": "string" },
    "name": { "type": "string" },
    "description": { "type": "string" },
    "rule": { "type": "string" },
    "applicable_context": { "type": "object" },
    "prerequisites": {
      "type": "array",
      "items": { "type": "string" }
    },
    "expected_outcome": { "type": "string" },
    "evidence": {
      "type": "array",
      "items": { "type": "string" }
    },
    "success_count": { "type": "integer", "minimum": 0 },
    "failure_count": { "type": "integer", "minimum": 0 },
    "inconclusive_count": { "type": "integer", "minimum": 0 },
    "confidence": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0
    },
    "status": {
      "type": "string",
      "enum": [
        "CANDIDATE",
        "VALIDATED",
        "SUPPORTED",
        "WEAKENED",
        "RETIRED",
        "SUPERSEDED"
      ]
    },
    "version": { "type": "integer", "minimum": 1 },
    "provenance": { "type": "object" },
    "source_experiences": {
      "type": "array",
      "items": { "type": "string" }
    },
    "supersedes": { "type": ["string", "null"] },
    "superseded_by": { "type": ["string", "null"] },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "metadata": { "type": "object" }
  },
  "additionalProperties": true
}
